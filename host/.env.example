# Copy to .env and fill in. Never commit .env.

# Discord. The bot needs the Message Content intent.
DISCORD_TOKEN=
# Channel labels are not set here: they come from governance/discord.json in UOR-Foundation/community,
# at the commit the community's signed holo was built from. See docs/context.md.
# true only if a server admin installed the bot.
INSTALLED_BY_ADMIN=false
# true only if the Message Content intent is granted to the bot in the Discord developer portal.
MESSAGE_CONTENT_INTENT=false
# Role ids that count as admin, besides Manage Server.
ADMIN_ROLES=

# Language model. LLM_PROVIDER is anthropic, openai-compatible, or ollama (LLM_URL defaults to http://localhost:11434/v1).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# openai-compatible: OpenAI, xAI, or a local Ollama at http://localhost:11434/v1.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# false for reasoning models (Qwen3, GLM, DeepSeek), so the answer holds no reasoning.
LLM_THINKING=false

# Embeddings: any server with the OpenAI embeddings route.
# Local: EMBEDDINGS_URL=http://localhost:11434/v1 and EMBEDDINGS_MODEL=nomic-embed-text (Ollama).
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Prefixes some models need. For nomic-embed-text: "search_query: " and "search_document: ".
EMBEDDINGS_QUERY_PREFIX=
EMBEDDINGS_DOCUMENT_PREFIX=

# Store of record. Leave KAPPA_REGISTRY_URL empty to use a local folder.
KAPPA_REGISTRY_URL=
KAPPA_REGISTRY_TOKEN=
KAPPA_NAMESPACE_PUBLIC=uor-agent/public
KAPPA_NAMESPACE_PRIVATE=uor-agent/private
STORE_DIR=./data/store
INDEX_FILE=./data/index.sqlite
BACKFILL_FILE=./data/backfill.json

# Knowledge.
# The community root. The commit is read from the holo's verified provenance, never set here.
COMMUNITY_REPOSITORY=UOR-Foundation/community
COMMUNITY_HOLO_URL=https://uor-foundation.github.io/community/app.holo
COMMUNITY_SIGNER=https://github.com/UOR-Foundation/community/.github/workflows/pages.yml@refs/heads/main
COMMUNITY_CACHE_DIR=./data/community
# A token with public read access. Without one GitHub allows 60 requests an hour, too few for the organization.
GITHUB_TOKEN=
# Repository names to index, comma separated. Empty means every public repository.
GITHUB_REPOSITORIES=

# Days a Discord item is kept, 1 to 254.
RETENTION_DAYS=180

# Limits (1 to 255) and the similarity that counts as a medium or high match.
RATE_USER_LIMIT=5
RATE_CHANNEL_LIMIT=20
RATE_WINDOW_SECONDS=60
SIMILARITY_MEDIUM=0.35
SIMILARITY_HIGH=0.5
RETRIEVE=6

# LangBot's pipeline settings (docs/langbot.md). Each is a fact the kernel decides on.
# Access control: blacklist or whitelist, over channel ids, user ids, or * for every one.
ACCESS_MODE=blacklist
ACCESS_LIST=
# Content filter: both, incoming or outgoing, and the terms it looks for, comma separated.
FILTER_SCOPE=both
FILTER_TERMS=
# A reply longer than one message and up to five: split or file. Longer is always a file.
LONG_TEXT=split
# Questions worked on at once.
CONCURRENCY=4

# MCP servers, as JSON. A tool is called only on a server with "allow": true, and a tool
# that writes (not marked read-only) only for the admin role: the kernel decides each call.
# [{"name": "lexlean", "url": "https://example.org/mcp", "allow": true}, {"name": "local", "command": "uor-mcp", "args": []}]
MCP_SERVERS=
