{
  "name": "uor-discord-agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host shell of the UOR Discord agent: every effect, no policy.",
  "license": "(MIT OR Apache-2.0)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "prism-code generate ../app/.prism/build/uor-discord-agent.holo --out src/client",
    "test": "node --test --no-warnings \"test/*.test.ts\"",
    "start": "node --no-warnings --env-file-if-exists=.env src/main.ts",
    "ingest": "node --no-warnings --env-file-if-exists=.env src/main.ts ingest",
    "typecheck": "tsc",
    "backfill": "node --no-warnings --env-file-if-exists=.env src/main.ts backfill"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@uor-foundation/uor-addr": "0.4.0",
    "discord.js": "14.28.1",
    "prism-code": "0.11.2",
    "sigstore": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
