{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UOR-Foundation/q/docs/schemas/experiment-event.schema.json",
  "title": "org.uorfoundation.q.experiment",
  "description": "The public trace of one try of a chaos experiment, as a CloudEvents 1.0 JSON event on the agent's standard output. Its id is the BLAKE3 kappa label of the result record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "type",
    "source",
    "id",
    "time",
    "datacontenttype",
    "data"
  ],
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "brief": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "errorPct",
        "p95Seconds",
        "breaches"
      ],
      "properties": {
        "errorPct": {
          "type": "integer"
        },
        "p95Seconds": {
          "type": [
            "number",
            "integer"
          ]
        },
        "breaches": {
          "type": "integer"
        }
      }
    }
  },
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "type": {
      "const": "org.uorfoundation.q.experiment"
    },
    "source": {
      "const": "https://github.com/UOR-Foundation/q"
    },
    "id": {
      "$ref": "#/$defs/label"
    },
    "time": {
      "type": "string"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "name",
        "fault",
        "verdict",
        "control",
        "experimental",
        "kernel",
        "community"
      ],
      "properties": {
        "experiment": {
          "$ref": "#/$defs/label"
        },
        "name": {
          "type": "string"
        },
        "fault": {
          "enum": [
            "llm-busy",
            "llm-down",
            "llm-slow",
            "llm-malformed",
            "embedder-down",
            "burst"
          ]
        },
        "verdict": {
          "enum": [
            "confirmed",
            "disproved",
            "held",
            "aborted"
          ]
        },
        "control": {
          "$ref": "#/$defs/brief"
        },
        "experimental": {
          "$ref": "#/$defs/brief"
        },
        "kernel": {
          "$ref": "#/$defs/label"
        },
        "community": {
          "$ref": "#/$defs/label"
        }
      }
    }
  }
}
